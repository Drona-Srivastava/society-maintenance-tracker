# Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/society_db

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Complaint SLA
COMPLAINT_OVERDUE_DAYS=3

# Email / Brevo
BREVO_API_KEY=replace-with-your-brevo-api-key
EMAIL_FROM=no-reply@example.com

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONTAINER=uploads

# Testing (optional)
# TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/society_test
